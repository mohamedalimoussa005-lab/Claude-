# Copy to /etc/solana-scanner.env (root:root, mode 600) and replace the placeholder.
# Never commit the real file. Without HELIUS_API_KEY the collection uses the public RPC only.
HELIUS_API_KEY=REPLACE_ME
# Optional custom public RPC endpoint (must NOT contain a key):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
