{
  "name": "solana-memecoin-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "node --experimental-strip-types --no-warnings scripts/dev-full.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node --experimental-strip-types --no-warnings server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "test:live": "node --experimental-strip-types --no-warnings scripts/live-test.ts",
    "score:live": "node --experimental-strip-types --no-warnings scripts/score-live.ts",
    "onchain:live": "node --experimental-strip-types --no-warnings scripts/onchain-live.ts",
    "wallets:live": "node --experimental-strip-types --no-warnings scripts/wallets-live.ts",
    "outcomes:capture": "node --experimental-strip-types --no-warnings scripts/outcomes.ts capture",
    "outcomes:update": "node --experimental-strip-types --no-warnings scripts/outcomes.ts update",
    "outcomes:report": "node --experimental-strip-types --no-warnings scripts/outcomes.ts report",
    "outcomes:export": "node --experimental-strip-types --no-warnings scripts/outcomes.ts export",
    "outcomes:status": "node --experimental-strip-types --no-warnings scripts/outcomes.ts status",
    "outcomes:backup": "node --experimental-strip-types --no-warnings scripts/outcomes.ts backup",
    "outcomes:archive-legacy": "node --experimental-strip-types --no-warnings scripts/outcomes.ts archive-legacy",
    "outcomes:collect": "node --experimental-strip-types --no-warnings scripts/outcomes-collect.ts",
    "detective": "node --experimental-strip-types --no-warnings scripts/detective.ts",
    "radar": "node --experimental-strip-types --no-warnings scripts/social-radar.ts",
    "breaking": "node --experimental-strip-types --no-warnings scripts/breaking-signal.ts",
    "telegram": "node --experimental-strip-types --no-warnings scripts/telegram-setup.ts",
    "watch:start": "./scripts/breaking-watch.sh start",
    "watch:stop": "./scripts/breaking-watch.sh stop",
    "watch:status": "./scripts/breaking-watch.sh status",
    "watch:logs": "./scripts/breaking-watch.sh logs",
    "watch:simulate": "node --experimental-strip-types --no-warnings scripts/breaking-signal.ts watch --simulate",
    "smartmoney": "node --experimental-strip-types --no-warnings scripts/smart-money.ts",
    "smartmoney:demo": "node --experimental-strip-types --no-warnings scripts/smart-money.ts demo",
    "smartmoney:start": "./scripts/smart-money.sh start",
    "smartmoney:stop": "./scripts/smart-money.sh stop",
    "smartmoney:status": "./scripts/smart-money.sh status",
    "test:smart-money": "node --experimental-strip-types --no-warnings --test test/smart-money/*.test.ts",
    "smartmoney:wallet": "node --experimental-strip-types --no-warnings scripts/smart-money.ts wallet",
    "smartmoney:estimate": "node --experimental-strip-types --no-warnings scripts/smart-money.ts estimate",
    "smartmoney:preflight": "node --experimental-strip-types --no-warnings scripts/smart-money.ts preflight",
    "smartmoney:diagnose": "node --experimental-strip-types --no-warnings scripts/smart-money.ts diagnose"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
